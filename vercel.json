{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node .ops/build-solaris.mjs",
  "installCommand": "",
  "outputDirectory": "solaris-dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/solaris",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jogo",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/jogo/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/passeio",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/passeio/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/solaris",
      "destination": "https://qsdffayasuzsmngteika.supabase.co/functions/v1/solaris-experience"
    }
  ]
}
